{
  "name": "temporal-cdc-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TypeScript and SQLite temporal CDC replay investigation",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "build:data": "node scripts/generate.ts",
    "replay": "node scripts/replay.ts",
    "report": "node scripts/report.ts",
    "test": "node --test tests/*.test.ts",
    "query": "node scripts/query.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
